# Database (Neon/Supabase connection string)
DATABASE_URL=

# NextAuth
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Encrypts Google refresh/access tokens before storing them in the DB
TOKEN_ENCRYPTION_KEY=

# LLM — "mock" runs with no key at all (safe fallback summaries);
# switch to openai or anthropic once you have a key
LLM_PROVIDER=mock
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Email (SMTP — works with SendGrid, Mailgun, Gmail app-password, or Ethereal for testing)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM="Clinic <no-reply@clinic.example.com>"

# Google Calendar OAuth 2.0
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/google/callback

# Shared secret to authenticate Vercel Cron requests to /api/cron/*
CRON_SECRET=